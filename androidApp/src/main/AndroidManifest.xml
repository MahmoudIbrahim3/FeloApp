<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Thumbnails (Coil) and, later, the YouTube embedded player and catalog sync. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Knowing when the device is offline: the player shows "مفيش نت" at once and retries when it's back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Child-directed app (Families policy, Play "Advertising ID: No"): never use the advertising
         ID. Strips AD_ID even if a library's manifest merges it in. -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" tools:node="remove" />

    <application
        android:name=".FeeloApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">
        <!-- configChanges: rotating keeps the activity, so the YouTube player (a WebView) keeps
             playing instead of reloading. Compose handles the new size itself. -->
        <activity
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize"
            android:exported="true"
            android:name=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
