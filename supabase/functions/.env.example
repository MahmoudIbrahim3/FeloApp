# Copy to supabase/functions/.env for local runs (gitignored):
#   supabase functions serve refresh-youtube-data --env-file supabase/functions/.env
YOUTUBE_API_KEY=your-youtube-data-api-key
REFRESH_SECRET=generate-a-long-random-string
TARGET_REGIONS=EG,SA,AE,KW,QA,BH,OM,JO,LB,SY,IQ,PS,YE,SD,LY,TN,DZ,MA,MR,SO,DJ,KM
